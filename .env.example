# Databricks connection
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your-personal-access-token
DATABRICKS_WAREHOUSE_ID=your-sql-warehouse-id

# Optional: override config file location (default: ~/.dbx/config.yaml)
# DBX_CONFIG_PATH=/path/to/config.yaml

# Optional: comma-separated list of allowed schemas
# DBX_ALLOWED_SCHEMAS=my_schema,analytics,reporting

# Optional: default catalog
# DBX_DEFAULT_CATALOG=main
